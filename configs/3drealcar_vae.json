{
    "models": {
        "encoder": {
            "name": "ElasticSLatEncoder",
            "args": {
                "resolution": 64,
                "in_channels": 1024,
                "model_channels": 768,
                "latent_channels": 8,
                "num_blocks": 12,
                "num_heads": 12,
                "mlp_ratio": 4,
                "attn_mode": "swin",
                "window_size": 8,
                "use_fp16": true,
                "use_checkpoint": true
            }
        },
        "decoder": {
            "name": "ElasticSLatGaussianDecoder",
            "args": {
                "resolution": 64,
                "model_channels": 768,
                "latent_channels": 8,
                "num_blocks": 12,
                "num_heads": 12,
                "mlp_ratio": 4,
                "attn_mode": "swin",
                "window_size": 8,
                "use_fp16": true,
                "use_checkpoint": true,
                "representation_config": {
                    "lr": {
                        "_xyz": 1.0,
                        "_features_dc": 1.0,
                        "_opacity": 1.0,
                        "_scaling": 1.0,
                        "_rotation": 0.1
                    },
                    "perturb_offset": true,
                    "voxel_size": 1.5,
                    "num_gaussians": 32,
                    "2d_filter_kernel_size": 0.1,
                    "3d_filter_kernel_size": 9e-4,
                    "scaling_bias": 4e-3,
                    "opacity_bias": 0.1,
                    "scaling_activation": "softplus"
                }
            }
        }
    },
    "dataset": {
        "name": "SparseFeat2Render",
        "args": {
            "image_size": 512,
            "model": "dinov2_vitl14_reg",
            "resolution": 64,
            "min_aesthetic_score": 0.0,
            "max_num_voxels": 32768
        }
    },
    "trainer": {
        "name": "SLatVaeGaussianTrainer",
        "args": {
            "max_steps": 200000,
            "batch_size_per_gpu": 1,
            "batch_split": 1,
            "grad_accum_steps": 2,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 5e-5,
                    "weight_decay": 0.001
                }
            },
            "lr_scheduler": {
                "name": "CosineAnnealingLR",
                "args": {
                    "T_max": 100000,
                    "eta_min": 1e-6
                }
            },
            "ema_rate": [0.9999],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "grad_clip": 1.0,
            "i_log": 100,
            "i_print": 100,
            "i_sample": 1000,
            "i_save": 5000,
            "loss_type": "l1",
            "lambda_ssim": 0.2,
            "lambda_lpips": 0.2,
            "lambda_kl": 1e-06,
            "regularizations": {
                "lambda_vol": 100,
                "lambda_opacity": 0.0002
            }
        }
    }
}