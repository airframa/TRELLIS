{
    "models": {
        "decoder": {
            "name": "SLatGaussianDecoder",
            "args": {
                "resolution": 64,
                "model_channels": 768,
                "latent_channels": 8,
                "num_blocks": 12,
                "num_heads": 12,
                "mlp_ratio": 4,
                "attn_mode": "swin",
                "window_size": 8,
                "pe_mode": "ape",
                "use_fp16": true,
                "use_checkpoint": true,
                "qk_rms_norm": false,
                "representation_config": {
                    "lr": {
                        "_xyz": 1.0,
                        "_features_dc": 1.0,
                        "_opacity": 1.0,
                        "_scaling": 1.0,
                        "_rotation": 0.1
                    },
                    "perturb_offset": true,
                    "voxel_size": 1.5,
                    "num_gaussians": 32,
                    "2d_filter_kernel_size": 0.1,
                    "3d_filter_kernel_size": 9e-4,
                    "scaling_bias": 4e-3,
                    "opacity_bias": 0.1,
                    "scaling_activation": "softplus"
                }
            }
        }
    },
    "dataset": {
        "name": "SLat2Render",
        "args": {
            "image_size": 512,
            "latent_model": "dinov2_vitl14_reg_slat_enc_swin8_B_64l8_fp16",
            "min_aesthetic_score": 0.0,
            "max_num_voxels": 32768
        }
    },
    "trainer": {
        "name": "SLatVaeGaussianTrainer",
        "args": {
            "max_steps": 20000,
            "batch_size_per_gpu": 1,
            "batch_split": 1,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 0.00001,
                    "weight_decay": 0.01
                }
            },
            "lr_scheduler": {
                "name": "CosineAnnealingLR",
                "args": {
                    "T_max": 30000,
                    "eta_min": 0.000001
                }
            },
            "ema_rate": [0.9999],
            "fp16_mode": null,
            "grad_clip": 1.0,
            "num_workers": 8,
            "num_samples": 8,
            "i_log": 100,
            "i_print": 50,
            "i_sample": 1000,
            "i_save": 2000,
            "i_val": 1000,
            "loss_type": "l1",
            "lambda_ssim": 0.2,
            "lambda_lpips": 0.2,
            "lambda_kl": 0.0,
            "regularizations": {
                "lambda_vol": 10000.0,
                "lambda_opacity": 0.001
            },
            "early_stopping": {
                "patience": 5000,
                "min_delta": 0.0001
            }
        }
    }
}